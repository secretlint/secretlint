{
    "name": "@secretlint/config-loader",
    "version": "14.0.1",
    "description": "Config loader for secretlint.",
    "keywords": [
        "secretlint",
        "node",
        "config",
        "loader"
    ],
    "homepage": "https://github.com/secretlint/secretlint/tree/master/packages/@secretlint/config-loader/",
    "bugs": {
        "url": "https://github.com/secretlint/secretlint/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/secretlint/secretlint.git"
    },
    "license": "MIT",
    "author": "azu",
    "type": "module",
    "exports": {
        ".": {
            "import": {
                "types": "./module/index.d.ts",
                "default": "./module/index.js"
            },
            "default": "./module/index.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./module/index.js",
    "types": "./module/index.d.ts",
    "directories": {
        "lib": "lib",
        "test": "test"
    },
    "files": [
        "bin/",
        "module/",
        "src/"
    ],
    "scripts": {
        "build": "tsc --build",
        "clean": "tsc --build --clean",
        "prepublishOnly": "npm run clean && npm run build",
        "prepublish": "npm run --if-present build",
        "test": "vitest run",
        "updateSnapshot": "UPDATE_SNAPSHOT=1 npm test",
        "watch": "tsc --build --watch"
    },
    "dependencies": {
        "@secretlint/core": "workspace:*",
        "@secretlint/profiler": "workspace:*",
        "@secretlint/resolver": "workspace:*",
        "@secretlint/types": "workspace:*",
        "debug": "catalog:",
        "rc-config-loader": "catalog:"
    },
    "devDependencies": {
        "@secretlint/secretlint-rule-internal-test-cjs": "workspace:*",
        "@secretlint/secretlint-rule-internal-test-esm": "workspace:*",
        "@types/debug": "catalog:",
        "@types/node": "catalog:",
        "typescript": "catalog:"
    },
    "engines": {
        "node": ">=22.18.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
