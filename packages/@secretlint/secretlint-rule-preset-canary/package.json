{
    "name": "@secretlint/secretlint-rule-preset-canary",
    "version": "13.1.0",
    "description": "Canary rule preset of secretlint.",
    "keywords": [
        "secretlint",
        "rule",
        "rule-preset"
    ],
    "homepage": "https://github.com/secretlint/secretlint/tree/master/packages/@secretlint/secretlint-rule-preset-canary/",
    "bugs": {
        "url": "https://github.com/secretlint/secretlint/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/secretlint/secretlint.git"
    },
    "license": "MIT",
    "author": "azu",
    "type": "module",
    "exports": {
        ".": {
            "import": {
                "types": "./module/index.d.ts",
                "default": "./module/index.js"
            },
            "default": "./module/index.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./module/index.js",
    "types": "./module/index.d.ts",
    "directories": {
        "lib": "lib",
        "test": "test"
    },
    "files": [
        "bin/",
        "module/",
        "src/"
    ],
    "scripts": {
        "build": "tsc --build",
        "clean": "tsc --build --clean",
        "prepublishOnly": "npm run clean && npm run build",
        "prettier": "prettier --write \"**/*.{js,jsx,ts,tsx,css}\"",
        "prepublish": "npm run --if-present build",
        "watch": "tsc --build --watch"
    },
    "prettier": {
        "printWidth": 120,
        "singleQuote": false,
        "tabWidth": 4
    },
    "dependencies": {
        "@secretlint/core": "workspace:*",
        "@secretlint/types": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "prettier": "catalog:",
        "rimraf": "catalog:",
        "typescript": "catalog:"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}
